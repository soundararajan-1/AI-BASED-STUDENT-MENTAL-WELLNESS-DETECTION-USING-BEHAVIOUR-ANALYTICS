# ==============================================================================
# AI-Based Student Mental Wellness Detection - Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (Supabase PostgreSQL / Local Fallback)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
USE_SQLITE_FALLBACK=true

# AI & LLM Service Configuration (Backend Only - NEVER expose to frontend)
OPENAI_API_KEY=your-openai-api-key-here
# Optional fallback provider
GEMINI_API_KEY=your-gemini-api-key-here

# Random Forest Model Artifact Path
MODEL_ARTIFACT_PATH=backend/app/ml/rf_wellness_model.joblib
