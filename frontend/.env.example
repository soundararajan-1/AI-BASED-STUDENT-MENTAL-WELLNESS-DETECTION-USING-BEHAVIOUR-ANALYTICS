# ==============================================================================
# AI-Based Student Mental Wellness Detection - Frontend Environment Variables
# Notice: Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put secret server API keys (such as OpenAI or service keys) in this file.
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:8000

# Supabase Client Configuration (Public Anon Key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
